{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Skill",
  "description": "Schema for OpenCode Engineering Kit Skills",
  "type": "object",
  "required": ["name", "description", "category", "version", "author", "compatible"],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "Unique skill identifier"
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "maxLength": 200,
      "description": "Brief description of the skill"
    },
    "category": {
      "type": "string",
      "enum": ["ai", "analytics", "architecture", "arts", "automation", "automotive", "backend", "cloud", "code-quality", "code-review", "commercial", "community", "construction", "database", "design", "devops", "documentation", "education", "embedded", "engineering", "finance", "frontend", "git", "health", "humanities", "iot", "languages", "law", "logistics", "management", "marketing", "methodology", "mobile", "music", "projects", "quality", "robotics", "science", "security", "sports", "testing", "tools", "vision", "web"],
      "description": "Skill category"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Semantic version"
    },
    "author": {
      "type": "string",
      "description": "Skill author"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Searchable tags"
    },
    "compatible": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["opencode", "claude-code", "cursor", "copilot"]
      },
      "description": "Compatible platforms"
    },
    "requires": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Prerequisites"
    },
    "provides": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "What this skill provides"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        }
      },
      "description": "Other skills this depends on"
    },
    "difficulty": {
      "type": "string",
      "enum": ["beginner", "intermediate", "advanced"],
      "description": "Skill difficulty level"
    },
    "frameworks": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Related frameworks"
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Related programming languages"
    },
    "provenance": {
      "type": "object",
      "description": "Source/origin of the skill content",
      "properties": {
        "source": {
          "type": "string",
          "description": "Name of the source project, organization or method"
        },
        "url": {
          "type": "string",
          "description": "URL of the source"
        },
        "license": {
          "type": "string",
          "description": "License of the source material"
        },
        "verified": {
          "type": "string",
          "description": "Date the source was verified (YYYY-MM-DD)"
        }
      }
    },
    "security": {
      "type": "object",
      "description": "Security posture of the skill",
      "properties": {
        "risk_level": {
          "type": "string",
          "enum": ["none", "low", "medium", "high"],
          "description": "Risk of running this skill's instructions (none = pure guidance, high = executes untrusted input)"
        },
        "permissions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Permissions or capabilities the skill may require (e.g. filesystem, network, secrets)"
        },
        "audited": {
          "type": "boolean",
          "description": "Whether the skill content passed the security content scan"
        }
      }
    }
  }
}