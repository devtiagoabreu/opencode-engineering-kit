{
  "name": "opencode-engineering-kit",
  "version": "0.1.1",
  "description": "CLI to install the OpenCode Engineering Kit (skills, agents, commands, context) into any existing project via .opencode/.",
  "type": "module",
  "bin": {
    "opencode-engineering-kit": "bin/opencode-engineering-kit.js"
  },
  "main": "src/install.js",
  "exports": {
    ".": "./src/install.js"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devtiagoabreu/opencode-engineering-kit.git",
    "directory": "cli"
  },
  "homepage": "https://github.com/devtiagoabreu/opencode-engineering-kit#readme",
  "bugs": {
    "url": "https://github.com/devtiagoabreu/opencode-engineering-kit/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "prepublishOnly": "npm test && npm pack --dry-run"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "opencode",
    "skills",
    "agents",
    "ai",
    "engineering-kit",
    "cli"
  ],
  "license": "MIT"
}
